{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Autonomous Remediation Loop State",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "loop_id", "phase", "candidate_id", "state", "lineage", "attempts", "current_spec_hash", "review_artifacts", "finding_fingerprints", "next_transition", "safety"],
  "properties": {
    "schema_version": {"const": 1},
    "loop_id": {"type": "string", "minLength": 1},
    "phase": {"type": "string", "minLength": 1},
    "candidate_id": {"type": "string", "minLength": 1},
    "state": {"enum": ["REVIEW_REJECTED", "REMEDIATION_READY", "REMEDIATION_RUNNING", "PENDING_INDEPENDENT_REVIEW", "HUMAN_GATE_REQUIRED", "CLOSED"]},
    "current_spec_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "finding_fingerprints": {"type": "array", "uniqueItems": true, "items": {"type": "string", "pattern": "^[0-9a-f]{64}$"}},
    "review_artifacts": {"type": "array", "minItems": 1, "items": {"type": "object", "additionalProperties": false, "required": ["path", "sha256", "decision"], "properties": {"path": {"type": "string"}, "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}, "decision": {"type": "string"}}}},
    "lineage": {"type": "array", "items": {"type": "object"}},
    "attempts": {"type": "array", "items": {"type": "object"}},
    "next_transition": {"type": "string", "minLength": 1},
    "safety": {"type": "object", "additionalProperties": false, "required": ["allowed_data_window", "live_execution_authorized", "review_bypass_authorized", "scope_change_authorized"], "properties": {"allowed_data_window": {"const": []}, "live_execution_authorized": {"const": false}, "review_bypass_authorized": {"const": false}, "scope_change_authorized": {"const": false}}}
  }
}
