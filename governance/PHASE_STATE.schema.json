{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Project Phase State",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "phase_id",
    "status",
    "base_commit",
    "orchestrator",
    "gates",
    "data_access",
    "transitions"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "phase_id": {
      "type": "string"
    },
    "status": {
      "enum": [
        "PROPOSED",
        "DATA_PREPARATION",
        "DESIGN_FROZEN",
        "IMPLEMENTATION_REVIEW",
        "DISCOVERY_RUNNING",
        "DISCOVERY_FROZEN",
        "CONFIRMATION_UNLOCKED",
        "CONFIRMATION_RUNNING",
        "CONFIRMATION_FROZEN",
        "HOLDOUT_UNLOCKED",
        "HOLDOUT_RUNNING",
        "VALIDATION",
        "COMPLETE",
        "CLOSED",
        "BLOCKED",
        "INVALID"
      ]
    },
    "base_commit": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "spec_sha256": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^[0-9a-f]{64}$"
    },
    "orchestrator": {
      "const": "project_orchestrator"
    },
    "gates": {
      "type": "object",
      "required": [
        "data",
        "freeze",
        "implementation",
        "statistics",
        "qa",
        "safety"
      ],
      "additionalProperties": {
        "$ref": "#/$defs/gate"
      }
    },
    "data_access": {
      "type": "object",
      "required": [
        "allowed_partitions",
        "locked_partitions"
      ],
      "properties": {
        "allowed_partitions": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "locked_partitions": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "unlock_manifest_sha256": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^[0-9a-f]{64}$"
        }
      },
      "additionalProperties": false
    },
    "transitions": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "from",
          "to",
          "authorized_by",
          "at_utc",
          "evidence_sha256"
        ],
        "properties": {
          "from": {
            "type": "string"
          },
          "to": {
            "type": "string"
          },
          "authorized_by": {
            "const": "project_orchestrator"
          },
          "at_utc": {
            "type": "string",
            "format": "date-time"
          },
          "evidence_sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "human_owner_approval_sha256": {
            "type": [
              "string",
              "null"
            ],
            "pattern": "^[0-9a-f]{64}$"
          }
        },
        "additionalProperties": false
      }
    }
  },
  "$defs": {
    "gate": {
      "type": "object",
      "required": [
        "status",
        "reviewer_role",
        "evidence_sha256"
      ],
      "properties": {
        "status": {
          "enum": [
            "NOT_REQUIRED",
            "PENDING",
            "PASSED",
            "FAILED",
            "VETOED"
          ]
        },
        "reviewer_role": {
          "type": [
            "string",
            "null"
          ]
        },
        "evidence_sha256": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^[0-9a-f]{64}$"
        }
      },
      "additionalProperties": false
    }
  }
}
