# The default is intentionally non-executing. Live trading is not implemented.
MODE=BACKTEST

# Optional MT5 connection details. Do not add credentials to this file.
MT5_LOGIN=
MT5_PASSWORD=
MT5_SERVER=
MT5_PATH=

# Runtime settings
LOG_LEVEL=INFO
DATABASE_PATH=data/trading.db

# This project currently rejects all broker order submission, including DEMO and LIVE.
# Kept here so future work must make an explicit, reviewed configuration change.
LIVE_TRADING_CONFIRMATION=

